# ==========================================
# Node.js & SvelteKit
# ==========================================
node_modules/
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build

# ==========================================
# Operating System & Editors
# ==========================================
.DS_Store
Thumbs.db
*~
*.swp
*.swo

.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ==========================================
# Vite Build Timestamps
# ==========================================
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ==========================================
# Go Binaries, Workspaces & WASM Artifacts
# ==========================================
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
go.work
go.work.sum

# Ignore compiled WASM binaries (keep .gitkeep tracked)
/static/wasm/*.wasm
/static/wasm/wasm_exec.js
!/static/wasm/.gitkeep


# ==========================================
# SQLite Databases (Bun ORM) under var/db
# ==========================================
/var/db/*.db
/var/db/*.db-shm
/var/db/*.db-wal
!/var/db/.gitkeep


# ==========================================
# Runtime State & Storage (var/ directory)
# ==========================================
# Environment Variables
!/var.env.example

# SQLite Databases (Bun ORM)
/var/database/*.db
/var/database/*.db-shm
/var/database/*.db-wal

# Logs & CSV Exports
/var/logs/*.log
/var/logs/*.csv

# FAME Cryptographic State (.gob files)
/var/fame/*.gob
!/var/fame/.gitkeep

# SSL Certificates & Private Keys
/var/ssl/*.pem
/var/ssl/*.key
/var/ssl/*.csr
!/var/ssl/.gitkeep

# General Secrets & Keys
/var/key/*.key
/var/key/*.pem
!/var/key/.gitkeep
